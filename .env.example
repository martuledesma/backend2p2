# Puerto en el que se levanta el servidor
PORT=8080

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Cadena de conexión a MongoDB. Usada para conectar el servidor a la base
# (podés usar una instancia local o un cluster de MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017/plataforma-eventos

# Secreto utilizado para firmar tokens JWT. Usá un valor largo y aleatorio
# en un entorno real; nunca lo hardcodees en el código.
JWT_SECRET=changeme

# Tiempo de expiración del JWT (formato admitido por jsonwebtoken: "1h", "7d", etc.)
JWT_EXPIRES_IN=1h

# Credenciales SMTP para Nodemailer (envío del email de confirmación de
# inscripción). Nunca se hardcodean en el código. Si no se completan, el
# servidor sigue funcionando: simplemente omite el envío del email con un
# warning en consola.
#
# Para pruebas sin cuenta real se puede usar https://ethereal.email (genera
# un usuario/contraseña de prueba gratis y un preview link por cada email).
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Plataforma de Eventos <no-reply@plataforma-eventos.com>"
