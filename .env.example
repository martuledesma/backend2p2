# Puerto en el que se levanta el servidor
PORT=8080

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Cadena de conexión a MongoDB. Usada para conectar el servidor a la base
# (podés usar una instancia local o un cluster de MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017/plataforma-eventos

# Secreto utilizado para firmar tokens JWT (se utilizará a partir del módulo de login)
JWT_SECRET=changeme
